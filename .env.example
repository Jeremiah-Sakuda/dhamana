# ─────────────────────────────────────────────────────────────────────────────
# Dhamana environment configuration
# Copy to `.env.local` for local dev. Set these in the Vercel dashboard for prod.
# ─────────────────────────────────────────────────────────────────────────────

# Which database backend to run against.
#   memory   → zero-dependency in-process engine that faithfully reproduces DSQL's
#              optimistic-concurrency-control (OCC) commit-time conflict (SQLSTATE 40001).
#              Default. Lets you run the full app + the two-region race with no AWS / no Postgres.
#   postgres → any standard Postgres (local or RDS) using SERIALIZABLE isolation,
#              which also raises 40001 on conflict. Set DATABASE_URL.
#   dsql     → Amazon Aurora DSQL with IAM auth tokens. Set the DSQL_* vars below.
DB_BACKEND=memory

# ── postgres backend ─────────────────────────────────────────────────────────
# DATABASE_URL=postgres://user:pass@localhost:5432/dhamana

# ── Aurora DSQL backend (production) ─────────────────────────────────────────
# Region A serves the buyer geography; Region B serves the seller geography.
# Both are strongly-consistent read/write endpoints of the same multi-region cluster.
# Use the two PEERED regional endpoints of your multi-region cluster (same
# continent — e.g. us-east-1 + us-west-2 with a US witness).
# DSQL_REGION_A_HOST=<cluster-id-a>.dsql.us-east-1.on.aws
# DSQL_REGION_A=us-east-1
# DSQL_REGION_B_HOST=<cluster-id-b>.dsql.us-west-2.on.aws
# DSQL_REGION_B=us-west-2
# DSQL_DATABASE=postgres
# DSQL_USER=admin
# AWS_ACCESS_KEY_ID=...      # scoped IAM user with dsql:DbConnectAdmin on the cluster
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Demo controls (/api/reset, /api/load) wipe + reseed the DB. Enabled by default
# so the live showpiece works; set DEMO_MODE=off on a hardened deployment.
# DEMO_MODE=on

# Per-event ticket caps and platform fees are configured per verified-fan tier in
# src/lib/tiers.ts (enforced inside the buy transaction). Default inventory
# sharding (buckets per section) is DEFAULT_BUCKETS there too.
